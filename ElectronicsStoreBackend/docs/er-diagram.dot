digraph ER {
graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.1, newrank=true, fontname="Helvetica", fontsize=22, label="Electronics Store Backend - ER diagram (16 required entities)\nPK = primary key, FK = foreign key, U = unique.  Crow's foot = many, bar = one.", labelloc=t, pad=0.4];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [color="#555555", penwidth=1.2, arrowsize=0.9];
